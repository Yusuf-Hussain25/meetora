# URL of the Meetora API server (server/)
VITE_BASE_URL="http://localhost:3000"

# Clerk -> dashboard.clerk.com -> your app -> Configure -> API keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY='pk_test_...'

# Optional: show "Explore with a demo account" on the login page.
# Use the same email as DEMO_EMAIL in server/.env (created by `npm run seed`).
# The server signs the visitor in with a one-time Clerk ticket, so no password lives in the browser.
VITE_DEMO_EMAIL='demo@meetora-demo.dev'
