# URL of the Meetora API server (server/)
VITE_BASE_URL="http://localhost:3000"

# Clerk -> dashboard.clerk.com -> your app -> Configure -> API keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY='pk_test_...'

# Optional: demo account shown as "Explore with a demo account" on the login page.
# Created by `npm run seed` in server/ (same values as DEMO_EMAIL / SEED_PASSWORD there).
VITE_DEMO_EMAIL='demo@meetora-demo.dev'
VITE_DEMO_PASSWORD=''
