# Comma-separated list of browser origins allowed to call the API and open sockets
ORIGINS="http://localhost:5173"

# Neon Postgres connection string
# console.neon.tech -> your project -> Connect -> copy the connection string
DATABASE_URL='postgresql://user:password@ep-xxxx.region.aws.neon.tech/meetora?sslmode=require'

# Clerk -> dashboard.clerk.com -> your app -> Configure -> API keys
CLERK_PUBLISHABLE_KEY='pk_test_...'
CLERK_SECRET_KEY='sk_test_...'

# Optional. Clerk -> Configure -> Webhooks -> add endpoint <api-url>/api/clerk
# (events: user.created, user.updated, user.deleted) -> copy the Signing Secret.
# Without it, users are still created on their first API request.
CLERK_WEBHOOK_SIGNING_SECRET='whsec_...'

# Demo data (npm run seed). Setting DEMO_EMAIL also enables POST /api/demo/session, which the
# "Explore with a demo account" button uses (set VITE_DEMO_EMAIL in client/.env to show it).
# DEMO_PASSWORD lets you log in to the demo account by hand.
DEMO_EMAIL='demo@meetora-demo.dev'
DEMO_PASSWORD='choose-a-strong-password'
# Password for the other seeded teammates (@meetora-demo.dev)
SEED_PASSWORD='choose-another-strong-password'

# AI features (recap, ask the meeting, catch me up, agenda drafts). Set ONE of these keys.
# Gemini (free tier, no card): aistudio.google.com -> Get API key -> Create API key
GEMINI_API_KEY=''
# GEMINI_MODEL='gemini-2.5-flash'
# Claude (paid, best quality): console.anthropic.com -> API keys -> Create key
ANTHROPIC_API_KEY=''
# CLAUDE_MODEL='claude-opus-5-5'
# Optional: force a provider when both keys are set (anthropic | gemini)
# AI_PROVIDER=''
